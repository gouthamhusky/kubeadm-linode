# Terraform secrets — never commit
*.tfvars

# Terraform provider cache — auto-generated, large binaries
.terraform/

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan output (may contain secrets)
*.tfplan

# Terraform state — contains live resource IDs and may contain secrets
*.tfstate
*.tfstate.backup
.terraform.tfstate.lock.info

# macOS
.DS_Store
